{
  "name": "@wypratama/use-validation",
  "version": "0.1.0",
  "description": "Tiny reactive form validation for React",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "oxlint index.js test",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "check:types": "npm run build:types && git diff --exit-code -- index.d.ts",
    "lint:pack": "publint",
    "prepack": "npm run build:types",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "react-use-reactive": "^2.0.0-beta.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.14.0",
    "publint": "^0.3.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Wicaksana Pratama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wypratama/use-validation.git"
  },
  "keywords": [
    "react",
    "validation",
    "form",
    "hook",
    "standard-schema"
  ]
}
